# Vocabulary versions implemented in this repo.
# Compare against spec/VOCAB_VERSIONS to detect drift.
# Run scripts/check-downstream-versions.sh from spec/ to check all repos at once.
# Update this file when adding new model/predicate support for a vocabulary version.
core=3.5
health=2.6
clinical=1.14
coverage=1.4
